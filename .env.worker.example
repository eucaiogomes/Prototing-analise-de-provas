# O worker roda fora da Vercel, onde existe ffmpeg. Copie para .env.worker.

API_BASE=https://prototing-analise-de-provas.vercel.app

# O mesmo valor que estiver em WORKER_SECRET nas variáveis do projeto na Vercel.
# É ele que impede alguém de escrever um resultado falso num job.
WORKER_SECRET=troque-por-um-valor-longo-e-aleatorio

# Storage > Blob > .env.local, ou `vercel env pull`
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

GEMINI_API_KEY=...

# Chamadas simultâneas ao modelo de visão. A etapa de visão é 80% do tempo.
PARALELO=6
